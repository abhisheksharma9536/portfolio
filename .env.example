# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Ask Abhishek (AI assistant) -------------------------------------------
# Required for the assistant. Server-side only — never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5
# Optional: low | medium | high. Defaults to low (fast, concise grounded answers).
# ANTHROPIC_EFFORT=low

# --- Contact form (email delivery via Resend) -------------------------------
# Required for the contact form: https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered. Defaults to abhisheksharma0265@gmail.com.
# CONTACT_TO_EMAIL=
# Sender. Defaults to Resend's test sender "Portfolio Contact <onboarding@resend.dev>",
# which can only deliver to the email that owns the Resend account. After verifying
# a domain in Resend, set e.g. "Portfolio <contact@yourdomain.com>".
# CONTACT_FROM_EMAIL=

# --- Rate limiting (optional) -------------------------------------------------
# Without these, limits are enforced per serverless instance (in memory).
# With an Upstash Redis database they are shared across all instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Site URL (optional) ------------------------------------------------------
# Canonical URL for metadata, sitemap and JSON-LD. On Vercel this falls back to
# the project's production domain automatically; set it once you add a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
